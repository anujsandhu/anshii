# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pptx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (never commit real secrets)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Firebase Admin SDK Credentials (NEVER commit service account private keys)
*-firebase-adminsdk-*.json
service-account*.json
firebase-admin*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw instagram dump
instagram-anujsandhuu-*/
