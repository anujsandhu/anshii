# ==============================================================================
# 🎂 Anshika's 19th Birthday Scrapbook — Environment Configuration
# ==============================================================================

# ── 1. Site Authentication & Security ──
# Main secret password required to unlock the scrapbook experience
SITE_PASSWORD=ANSHII19

# Secret key required to access the /admin analytics dashboard
ADMIN_KEY=@Ritusandhu1983

# Session token encryption secret and cookie duration (hours)
AUTH_SESSION_SECRET=anshii_bday_secret_salt_2026_key
SESSION_DURATION_HOURS=24

# ── 2. Cloudinary Media Storage (Signed Image Uploads) ──
# Found in your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Public cloud name exposed to client if needed
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ── 3. Firebase Firestore & Admin SDK ──
# Option A (Recommended for Vercel): Stringified or Base64 encoded Service Account JSON
# In Vercel Project Settings > Environment Variables, paste the contents of your
# service-account.json into FIREBASE_SERVICE_ACCOUNT_KEY
FIREBASE_SERVICE_ACCOUNT_KEY=

# Option B: Individual credentials from your Firebase service account JSON
FIREBASE_PROJECT_ID=anshii-52fd5
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── 4. WhatsApp Cloud API / Notifications (Meta Developers) ──
# 1. Create an App at https://developers.facebook.com
# 2. Add WhatsApp product & configure Phone Number ID and Access Token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Recipient WhatsApp phone number in international format without + or spaces
WHATSAPP_TO_NUMBER=918278710552
WHATSAPP_API_VERSION=v21.0

# Public application base URL for serving media links (e.g. https://your-project.vercel.app)
APP_BASE_URL=
