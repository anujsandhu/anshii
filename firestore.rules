rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Sessions & Analytics Collections ─────────────────────────────
    // Tracks anonymous visitor sessions without collecting personal information
    match /sessions/{sessionId} {
      allow read: if request.auth != null; // Admin-only read via Admin SDK / Auth
      allow create, update: if request.resource.data.sessionId == sessionId
                            && request.resource.data.sessionId is string
                            && request.resource.data.startedAt is string;
      allow delete: if request.auth != null;

      // Sub-collection: chronological timeline events
      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.resource.data.type in [
          'session_start', 'session_end', 'page_view', 'navigation',
          'click', 'image_view', 'image_upload', 'error', 'song_play', 'task_complete'
        ];
        allow update, delete: if request.auth != null;
      }
    }

    // ── Uploads Metadata Collection ──────────────────────────────────
    // Stores Cloudinary public URLs & IDs (No binary data stored in Firestore)
    match /uploads/{uploadId} {
      allow read: if true; // Publicly readable for website scrapbooks & memories
      allow create: if request.resource.data.cloudinaryUrl is string
                    && request.resource.data.cloudinaryPublicId is string
                    && request.resource.data.uploadedAt is string;
      allow update, delete: if request.auth != null;
    }

    // ── Gift Snaps (Progressive Unboxing Polaroids) ───────────────────
    match /gift_snaps/{stepId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
